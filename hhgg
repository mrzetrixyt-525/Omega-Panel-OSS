#!/bin/bash
set -e

# Auto-detect and enter panel repository directory
if [ -d "Omega-Panel-V3-Incus" ]; then
    cd "Omega-Panel-V3-Incus"
fi

VPS_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$VPS_DIR"

RED='\033[0;31m'
GREEN='\033[0;32m'
CYAN='\033[0;36m'
NC='\033[0m'

ok()  { echo -e "${GREEN}[OK]${NC} $1"; }
fail() { echo -e "${RED}[FAIL]${NC} $1"; exit 1; }
step() { echo -e "\n${CYAN}==> $1${NC}"; }

if [ "$(id -u)" -ne 0 ]; then
    fail "Run as root: sudo bash setup.sh"
fi

step "1/12 — System dependencies & KVM tools"
apt-get update -y
apt-get install -y curl wget gnupg2 ca-certificates lsb-release socat jq \
                   software-properties-common cpu-checker qemu-kvm \
                   libvirt-daemon-system libvirt-clients bridge-utils virtinst virt-manager btrfs-progs
systemctl enable --now libvirtd || true
usermod -aG kvm root 2>/dev/null || true
usermod -aG libvirt root 2>/dev/null || true
ok "System and KVM dependencies ready"

step "2/12 — Install Incus & remove LXD conflicts"
for pkg in lxd lxd-client lxc incus; do
    if command -v dpkg >/dev/null; then
        if timeout 5 dpkg -l "$pkg" 2>/dev/null | grep -q "^ii"; then
            echo "  Removing conflicting package: $pkg..."
            apt-get remove -y --purge "$pkg" || true
        fi
    fi
done

if [ ! -S /var/lib/incus/unix.socket ] && ! command -v incus >/dev/null 2>&1; then
    echo "  Configuring Zabbly Incus repository..."
    mkdir -p /etc/apt/keyrings
    curl -fsSL https://pkgs.zabbly.com/key.asc -o /etc/apt/keyrings/zabbly.asc
    echo "deb [signed-by=/etc/apt/keyrings/zabbly.asc] https://pkgs.zabbly.com/incus/stable $(. /etc/os-release && echo $VERSION_CODENAME) main" | tee /etc/apt/sources.list.d/incus.list
    apt-get update -y
    apt-get install -y incus
fi
ok "Incus installed successfully"

step "3/12 — Initialize Incus service"
for i in $(seq 1 30); do
    [ -S /var/lib/incus/unix.socket ] && break
    sleep 1
done

for i in $(seq 1 30); do
    if timeout 5 incus admin init --auto 2>/dev/null; then
        break
    fi
    sleep 2
done
ok "Incus daemon initialized"

step "4/12 — Setup LXCFS & CPU Info Wrapper"
apt-get install -y lxcfs
mkdir -p /etc/systemd/system/incus-lxcfs.service.d
cat > /etc/systemd/system/incus-lxcfs.service.d/override.conf << 'OVERRIDE'
[Unit]
ConditionVirtualization=
OVERRIDE
systemctl daemon-reload 2>/dev/null || true
pkill -9 lxcfs 2>/dev/null || true
sleep 1
umount -l /var/lib/lxcfs 2>/dev/null || true
umount -l /var/lib/incus-lxcfs 2>/dev/null || true
rm -rf /var/lib/incus-lxcfs /var/lib/lxcfs 2>/dev/null || true
systemctl start incus-lxcfs.service 2>/dev/null || true

cat > /opt/incus-lxcfs-mount-wrapper.sh << 'WRAPPER'
#!/bin/sh
/opt/incus/share/lxcfs/lxc.mount.hook "$@"
LXC_ROOTFS="${LXC_ROOTFS_MOUNT}"
NPROC=1
BACKUP_YAML="/var/lib/incus/containers/${LXC_NAME}/backup.yaml"
if [ -f "$BACKUP_YAML" ]; then
    CONFIG_NPROC=$(grep -A2 'limits.cpu' "$BACKUP_YAML" 2>/dev/null | head -1 | sed 's/.*: *"\(.*\)"/\1/' | sed 's/[^0-9]//g')
    [ -n "$CONFIG_NPROC" ] && [ "$CONFIG_NPROC" -gt 0 ] 2>/dev/null && NPROC=$CONFIG_NPROC
fi
TMP_DIR="${LXC_ROOTFS}/dev/.lxc-cpuinfo"
mkdir -p "$TMP_DIR" 2>/dev/null
mount -t tmpfs tmpfs "$TMP_DIR" 2>/dev/null || true
CPUINFO_EMPTY=false
if [ -f "${LXC_ROOTFS}/proc/cpuinfo" ]; then
    READ_BYTES=$(head -c 1 "${LXC_ROOTFS}/proc/cpuinfo" 2>/dev/null | wc -c)
    [ "$READ_BYTES" = "0" ] && CPUINFO_EMPTY=true
fi
if [ "$CPUINFO_EMPTY" = true ]; then
    umount -n "${LXC_ROOTFS}/proc/cpuinfo" 2>/dev/null || true
    MODEL="AMD EPYC Processor"
    VENDOR="AuthenticAMD"
    FLAGS="fpu vme de pse tsc msr pae mce cx8 apic sep mtrr pge mca cmov pat pse36 clflush mmx fxsr sse sse2 ss ht syscall nx pdpe1gb rdtscp lm constant_tsc rep_good nopl cpuid tsc_known_freq pni pclmulqdq ssse3 fma cx16 pcid sse4_1 sse4_2 x2apic movbe popcnt aes xsave avx f16c rdrand hypervisor lahf_lm abm 3dnowprefetch cpuid_fault invpcid_single pti ssbd ibrs ibpb stibp fsgsbase bmi1 hle avx2 smep bmi2 erms invpcid rtm avx512f avx512dq rdseed adx smap avx512ifma clflushopt clwb avx512cd sha_ni avx512bw avx512vl xsaveopt xsavec xgetbv1 xsaves arat avx512vbmi umip pku ospke avx512_vbmi2 gfni vaes vpclmulqdq avx512_vnni avx512_bitalg avx512_vpopcntdq rdpid"
    MHZ="3294.688"
    CACHE="16384 KB"
    CPUINFO_FILE="${TMP_DIR}/cpuinfo"
    > "$CPUINFO_FILE"
    i=0
    while [ "$i" -lt "$NPROC" ]; do
        cat << EOF >> "$CPUINFO_FILE"
processor	: $i
vendor_id	: $VENDOR
cpu family	: 25
model		: 17
model name	: $MODEL
stepping	: 4
cpu MHz		: $MHZ
cache size	: $CACHE
physical id	: 0
siblings	: $NPROC
core id		: $i
cpu cores	: $NPROC
apicid		: $i
initial apicid	: $i
fpu		: yes
fpu_exception	: yes
cpuid level	: 13
wp		: yes
flags		: $FLAGS
bugs		: spectre_v1 spectre_v2 spec_store_bypass
bogomips	: 6589.37
clflush size	: 64
cache_alignment	: 64
address sizes	: 46 bits physical, 48 bits virtual
power management:

EOF
        i=$((i + 1))
    done
    mount -n --bind "$CPUINFO_FILE" "${LXC_ROOTFS}/proc/cpuinfo" 2>/dev/null || true
fi
SYS_CPU_DIR="${LXC_ROOTFS}/sys/devices/system/cpu"
if [ -d "$SYS_CPU_DIR" ]; then
    if [ "$NPROC" -eq 1 ]; then CPULIST="0"; else CPULIST="0-$((NPROC - 1))"; fi
    echo "$CPULIST" > "${TMP_DIR}/present"
    mount -n --bind "${TMP_DIR}/present" "${SYS_CPU_DIR}/present" 2>/dev/null || true
    echo "$CPULIST" > "${TMP_DIR}/online"
    mount -n --bind "${TMP_DIR}/online" "${SYS_CPU_DIR}/online" 2>/dev/null || true
    echo "$((NPROC - 1))" > "${TMP_DIR}/kernel_max"
    mount -n --bind "${TMP_DIR}/kernel_max" "${SYS_CPU_DIR}/kernel_max" 2>/dev/null || true
fi
exit 0
WRAPPER
chmod 755 /opt/incus-lxcfs-mount-wrapper.sh
ok "LXCFS wrapper ready"

step "5/12 — Storage, Networking & Pterodactyl Nesting Profile"
if ! timeout 10 incus storage show default >/dev/null 2>&1; then
    incus storage create default btrfs size=100GB 2>/dev/null || incus storage create default dir 2>&1 || true
fi

if ! timeout 10 incus network list 2>/dev/null | grep -q "incusbr0"; then
    incus network create incusbr0 --type=bridge ipv4.address=10.132.115.1/24 ipv4.nat=true ipv6.address=none 2>&1 || true
fi

timeout 10 incus profile device add default root disk path=/ pool=default 2>/dev/null || true
timeout 10 incus profile device add default eth0 nic name=eth0 network=incusbr0 2>/dev/null || true

# Docker & Pterodactyl Wings support settings
timeout 10 incus profile set default security.privileged=true 2>/dev/null || true
timeout 10 incus profile set default security.nesting=true 2>/dev/null || true
timeout 10 incus profile set default security.syscalls.intercept.mknod=true 2>/dev/null || true
timeout 10 incus profile set default security.syscalls.intercept.bpf=true 2>/dev/null || true
timeout 10 incus profile set default linux.kernel_modules="overlay,br_netfilter,ip_tables,ip6_tables,netlink_diag" 2>/dev/null || true
timeout 10 incus profile set default raw.lxc "lxc.apparmor.profile=unconfined
lxc.hook.mount = /opt/incus-lxcfs-mount-wrapper.sh" 2>/dev/null || true
ok "Incus profile configured for Docker / Pterodactyl"

step "6/12 — Pre-downloading Ubuntu and Debian Images"
for ver in 22.04 24.04 26.04; do
    if ! timeout 10 incus image list 2>/dev/null | grep -q "$ver"; then
        echo "  Downloading Ubuntu $ver..."
        timeout 300 incus image copy images:ubuntu/$ver local: --alias "$ver" --auto-update 2>&1 || true
    fi
done

for ver in 11 12 13; do
    if ! timeout 10 incus image list 2>/dev/null | grep -q "debian-$ver"; then
        echo "  Downloading Debian $ver..."
        timeout 300 incus image copy images:debian/$ver local: --alias "debian-$ver" --auto-update 2>&1 || true
    fi
done
ok "OS Images cached (Ubuntu 22.04/24.04/26.04 & Debian 11/12/13)"

step "7/12 — Python Environment Setup"
if ! command -v python3.10 >/dev/null 2>&1; then
    add-apt-repository ppa:deadsnakes/ppa -y 2>/dev/null || true
    apt-get update -y
    apt-get install -y python3.10 python3.10-venv python3.10-distutils python3-pip-whl python3-setuptools-whl || apt-get install -y python3 python3-venv python3-pip
fi

PY_BIN="$(command -v python3.10 || command -v python3)"
curl -sS https://bootstrap.pypa.io/get-pip.py | $PY_BIN
ok "Python environment ready"

step "8/12 — Setup Virtualenv & Dependencies"
$PY_BIN -m venv venv
source venv/bin/activate

# Auto-repair requirements files if missing
if [ ! -f "requirements.txt" ]; then
    cat > requirements.txt << 'REQ'
Flask
Flask-SQLAlchemy
requests
Werkzeug
gunicorn
REQ
fi

if [ ! -f "node_requirements.txt" ]; then
    cat > node_requirements.txt << 'REQ'
requests
REQ
fi

pip install --upgrade pip
pip install -r requirements.txt
pip install -r node_requirements.txt
ok "Python dependencies installed"

step "9/12 — Auto-Injecting Debian 11/12/13 into Web Frontend & DB"
# Update app.py dynamically if needed
venv/bin/python -c "
import os, sqlite3

# Try initializing DB via app module first
try:
    import app
    if hasattr(app, 'init_db'):
        app.init_db()
except Exception as e:
    print('App init note:', e)

# Force inject Debian and Ubuntu OS choices directly into SQLite DB
db_files = ['instance/database.db', 'database.db']
for db_path in db_files:
    if os.path.exists(db_path):
        conn = sqlite3.connect(db_path)
        cursor = conn.cursor()
        tables = [r[0] for r in cursor.execute(\"SELECT name FROM sqlite_master WHERE type='table';\").fetchall()]
        os_table = next((t for t in tables if 'os' in t.lower()), None)
        if os_table:
            os_entries = [
                ('Ubuntu 22.04 (Jammy Jellyfish)', '22.04', 'ubuntu', 'Ubuntu 22.04 LTS'),
                ('Ubuntu 24.04 (Noble Numbat)', '24.04', 'ubuntu', 'Ubuntu 24.04 LTS'),
                ('Ubuntu 26.04 (Resolute Raccoon)', '26.04', 'ubuntu', 'Ubuntu 26.04 LTS'),
                ('Debian 11 (Bullseye)', 'debian-11', 'debian', 'Debian 11 Bullseye'),
                ('Debian 12 (Bookworm)', 'debian-12', 'debian', 'Debian 12 Bookworm'),
                ('Debian 13 (Trixie)', 'debian-13', 'debian', 'Debian 13 Trixie')
            ]
            for name, alias, icon, desc in os_entries:
                try:
                    cursor.execute(f'INSERT OR IGNORE INTO {os_table} (name, alias, icon, description) VALUES (?, ?, ?, ?)', (name, alias, icon, desc))
                except Exception:
                    try:
                        cursor.execute(f'INSERT OR IGNORE INTO {os_table} (name, alias) VALUES (?, ?)', (name, alias))
                    except Exception:
                        pass
            conn.commit()
        conn.close()
"
ok "Database re-seeded with Debian and Ubuntu images"

step "10/12 — Systemd Auto-Restart Services"
cat > /etc/systemd/system/omega-panel.service << EOF
[Unit]
Description=Omega Panel Service
After=network.target incus.service

[Service]
Type=simple
User=root
WorkingDirectory=${VPS_DIR}
ExecStart=${VPS_DIR}/venv/bin/python ${VPS_DIR}/app.py
Restart=always
RestartSec=3s

[Install]
WantedBy=multi-user.target
EOF

cat > /etc/systemd/system/omega-node.service << EOF
[Unit]
Description=Omega Node Service
After=network.target incus.service

[Service]
Type=simple
User=root
WorkingDirectory=${VPS_DIR}
ExecStart=${VPS_DIR}/venv/bin/python ${VPS_DIR}/node.py
Restart=always
RestartSec=3s

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable --now omega-panel.service || true
systemctl enable --now omega-node.service || true
systemctl restart omega-panel.service || true
systemctl restart omega-node.service || true
ok "Auto-restart services started"

echo ""
echo -e "${GREEN}======================================================${NC}"
echo -e "${GREEN}   Omega Panel V3 — Fully Fixed & Deployed${NC}"
echo -e "${GREEN}======================================================${NC}"
echo "  Supported OS Options in Web Panel:"
echo "    • Ubuntu 22.04 / 24.04 / 26.04"
echo "    • Debian 11 / 12 / 13"
echo ""
echo "  Docker / Pterodactyl Support:"
echo "    • Nesting, privileged mode, and iptables modules enabled."
echo ""
echo "  Background Services Status:"
echo "    • Panel: systemctl status omega-panel"
echo "    • Node:  systemctl status omega-node"
echo -e "${GREEN}======================================================${NC}"
